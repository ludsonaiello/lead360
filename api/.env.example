NODE_ENV=production
PORT=8000

# JWT Configuration
JWT_SECRET=
JWT_REFRESH_SECRET=

# Application URL (for email links)
APP_URL=https://app.lead360.app

# This was inserted by `prisma init`:
# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.

# The following `prisma+postgres` URL is similar to the URL produced by running a local Prisma Postgres
# server with the `prisma dev` CLI command, when not choosing any non-default ports or settings. The API key, unlike the
# one found in a remote Prisma Postgres URL, does not contain any sensitive information.

DATABASE_URL=

# Redis Configuration (for BullMQ)
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=

# File Storage Configuration
UPLOADS_PATH=/var/www/lead360.app/app/uploads/public

#GOOGLE VISION API
GOOGLE_VISION_API_KEY=

#GOOGLE MAPS API
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY_SERVER=
# Encryption Key for SMTP passwords
ENCRYPTION_KEY=
SHADOW_DATABASE_URL=

# OCR Receipt AI Parsing (GPT-4o-mini)
OPENAI_API_KEY=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Voice Agent HTTP Client Configuration (Sprint VAB-03)
# This is a DEPLOYMENT SECRET (like JWT_SECRET, DATABASE_URL, etc.)
# It authenticates HTTP requests from voice agent child processes to the API.
#
# CURRENT KEY: Set during initial deployment. DO NOT commit to version control.
#
# IF YOU REGENERATE THE KEY (via Admin UI endpoint):
# 2. Copy the plain_key from response (shown ONCE only)
# 3. Update VOICE_AGENT_API_KEY below with new key
# 4. Restart NestJS: npm run start:dev OR pm2 restart lead360-api
# 5. All existing calls will drop during restart
#
#
LEAD360_API_URL=https://api.lead360.app
VOICE_AGENT_API_KEY=
VOICE_AGENT_TIMEOUT_MS=10000
VOICE_AGENT_MAX_RETRIES=2

GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URL=https://api.lead360.app/api/v1/calendar/integration/google/callback

# Portal JWT Secret (Sprint 31 — Customer Portal Authentication)
PORTAL_JWT_SECRET=

##### TWILLIO ATUAL

# Platform admin bootstrap — consumed by `npm run seed:admin`.
# Required: the seed refuses to run without them.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_FIRST_NAME=Platform
PLATFORM_ADMIN_LAST_NAME=Admin
